# Copy to .env on the host. Values are operator-supplied. Never commit a filled .env.

# HTTP
PORT=8787
PUBLIC_ORIGIN=https://bridge.example.invalid

# SQLite file path. In Docker/compose this should be on the persistent volume.
SQLITE_PATH=./data/bridge.sqlite

# Server-side pepper used when hashing setup codes and bearer tokens. Generate a long random string.
BRIDGE_PEPPER=

# Discord application (names only here; paste real values locally, never into git or chat)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Comma-separated Discord role IDs treated as operators (multi-team / staff).
OPERATOR_ROLE_IDS=

# Tuesday two-team shortcut: role and channel IDs, not names typed by agents.
# For Thursday or any larger test, replace these four variables with one compact JSON array:
# TEAM_SURFACES_JSON=[{"key":"team-a","label":"Team A","roleId":"...","channelId":"..."},{"key":"team-b","label":"Team B","roleId":"...","channelId":"..."}]
TEAM_A_ROLE_ID=
TEAM_A_CHANNEL_ID=
TEAM_B_ROLE_ID=
TEAM_B_CHANNEL_ID=

# Thursday questions channel. Unused if PHASE=team.
QUESTIONS_CHANNEL_ID=

# workshop phase: team | questions | both
PHASE=team

# When false, agents may sync questions but cannot post (recommended 12:00-14:00 Thursday).
QUESTIONS_POST_ENABLED=false

# Session credential lifetime in hours (default covers a workshop afternoon).
CREDENTIAL_TTL_HOURS=8
